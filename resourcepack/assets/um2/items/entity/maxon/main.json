{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "jab_windup",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/jab_windup"
        }
      },
      {
        "when": "jab_anim",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/jab_anim"
        }
      },
      {
        "when": "jab",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/jab"
        }
      },
      {
        "when": "jab_followup",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/jab_followup"
        }
      },
      {
        "when": "sweep_windup",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/sweep_windup"
        }
      },
      {
        "when": "sweep",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/sweep"
        }
      },
      {
        "when": "sweep_followup",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/sweep_followup"
        }
      },
      {
        "when": "sweep_2",
        "model": {
          "type": "minecraft:model",
          "model": "um2:entity/maxon/sweep_2"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "um2:entity/maxon/main"
    }
  }
}