{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": [
        {
          "when": "spawn_anim",
          "model": {
            "type": "minecraft:model",
            "model": "um2:entity/empyrean_array/hurt/spawn_anim"
          }
        },
        {
          "when": "supercharge_strike_windup",
          "model": {
            "type": "minecraft:model",
            "model": "um2:entity/empyrean_array/hurt/supercharge_strike_windup"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "um2:entity/empyrean_array/hurt/main"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "cases": [
        {
          "when": "spawn_anim",
          "model": {
            "type": "minecraft:model",
            "model": "um2:entity/empyrean_array/spawn_anim"
          }
        },
        {
          "when": "supercharge_strike_windup",
          "model": {
            "type": "minecraft:model",
            "model": "um2:entity/empyrean_array/supercharge_strike_windup"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "um2:entity/empyrean_array/main"
      }
    }
  }
}